FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY pyproject.toml .

RUN mkdir -p /app/certs/api /app/certs/ca /app/certs/coordinator

EXPOSE 8000

# Local Compose uses a generated development CA. Production should terminate
# externally managed TLS before this service and set equivalent HTTPS policy.
CMD ["sh", "-c", "test -r /app/certs/api/api.crt && test -r /app/certs/api/api.key && test -r /app/certs/ca/ca.crt && exec uvicorn backend.main:app --host 0.0.0.0 --port 8000 --ssl-certfile /app/certs/api/api.crt --ssl-keyfile /app/certs/api/api.key --ssl-ca-certs /app/certs/ca/ca.crt"]
