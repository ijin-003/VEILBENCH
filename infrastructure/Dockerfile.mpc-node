# One independently configured MPyC party process per container.
# Three containers on one VPS are not independent administrative domains.
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --system --gid 10001 veilbench \
    && useradd --system --uid 10001 --gid veilbench --home-dir /app veilbench

COPY backend/requirements-prod.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY backend/ ./backend/
COPY pyproject.toml ./pyproject.toml

RUN mkdir -p /app/.config /app/certs/control /app/certs/ca /var/lib/veilbench-party \
    && chown -R veilbench:veilbench /app /var/lib/veilbench-party

USER 10001:10001
EXPOSE 8100 11365 11366 11367

HEALTHCHECK --interval=10s --timeout=4s --start-period=20s --retries=5 \
    CMD python -c "import os,ssl,urllib.request; p=os.environ['MPC_PARTY_ID']; c=ssl.create_default_context(cafile='/app/certs/ca/ca.crt'); c.load_cert_chain(f'/app/.config/party_{p}.crt',f'/app/.config/party_{p}.key'); urllib.request.urlopen('https://localhost:8100/health', context=c, timeout=3)" || exit 1

CMD ["uvicorn", "backend.mpc.party_service:app", "--host", "0.0.0.0", "--port", "8100", "--ssl-certfile", "/app/certs/control/control.crt", "--ssl-keyfile", "/app/certs/control/control.key", "--ssl-ca-certs", "/app/certs/ca/ca.crt"]
