FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_STANDALONE=true
ARG NEXT_PUBLIC_API_URL=https://localhost:8000
ARG NEXT_PUBLIC_PARTY_0_URL=https://localhost:8100
ARG NEXT_PUBLIC_PARTY_1_URL=https://localhost:8101
ARG NEXT_PUBLIC_PARTY_2_URL=https://localhost:8102
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_PARTY_0_URL=$NEXT_PUBLIC_PARTY_0_URL \
    NEXT_PUBLIC_PARTY_1_URL=$NEXT_PUBLIC_PARTY_1_URL \
    NEXT_PUBLIC_PARTY_2_URL=$NEXT_PUBLIC_PARTY_2_URL
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN addgroup --system --gid 10001 nodejs \
    && adduser --system --uid 10001 --ingroup nodejs nextjs
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER 10001:10001
EXPOSE 3000
CMD ["node", "server.js"]
