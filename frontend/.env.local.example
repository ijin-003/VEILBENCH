# Browser-visible endpoints only. Never put credentials or signing secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=https://localhost:8000
NEXT_PUBLIC_PARTY_0_URL=https://localhost:8100
NEXT_PUBLIC_PARTY_1_URL=https://localhost:8101
NEXT_PUBLIC_PARTY_2_URL=https://localhost:8102

# For a Vercel deployment, set these to the public HTTPS coordinator and party
# endpoints. These values are embedded in the browser bundle at build time.
