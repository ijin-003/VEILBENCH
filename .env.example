# Copy to .env and replace every CHANGE_ME value with a unique random value.
# Use URL-safe values because POSTGRES_PASSWORD is interpolated into DATABASE_URL.

POSTGRES_USER=veilbench_user
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DATABASE_PASSWORD
POSTGRES_DB=veilbench_db

# Protects coordinator management endpoints (not founder salary submission).
COORDINATOR_ADMIN_TOKEN=CHANGE_ME_RANDOM_ADMIN_TOKEN

# Signs one short-lived, party-specific founder submission capability per session.
MPC_FOUNDER_TOKEN_SECRET_0=CHANGE_ME_RANDOM_FOUNDER_SIGNING_SECRET_0
MPC_FOUNDER_TOKEN_SECRET_1=CHANGE_ME_RANDOM_FOUNDER_SIGNING_SECRET_1
MPC_FOUNDER_TOKEN_SECRET_2=CHANGE_ME_RANDOM_FOUNDER_SIGNING_SECRET_2

# Separate control credentials; each belongs only to its corresponding party.
MPC_NODE0_TOKEN=CHANGE_ME_RANDOM_PARTY_0_CONTROL_TOKEN
MPC_NODE1_TOKEN=CHANGE_ME_RANDOM_PARTY_1_CONTROL_TOKEN
MPC_NODE2_TOKEN=CHANGE_ME_RANDOM_PARTY_2_CONTROL_TOKEN

# Public browser-facing URLs used to create founder invitations.
# In production, replace localhost with the three HTTPS party URLs and the
# actual Vercel deployment origin. Keep ALLOWED_ORIGINS aligned with it.
ENVIRONMENT=development
FRONTEND_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MPC_PARTY_PUBLIC_URLS=https://localhost:8100,https://localhost:8101,https://localhost:8102

# Party browser CORS. In production set this to the exact Vercel origin.
MPC_PARTY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production-only: set true with the production Compose mTLS listeners.
MPC_REQUIRE_CLIENT_CERT=false

# Public values consumed by the local Compose frontend. In a Vercel deployment,
# configure these as Vercel Project Environment Variables instead.
NEXT_PUBLIC_API_URL=https://localhost:8000
NEXT_PUBLIC_PARTY_0_URL=https://localhost:8100
NEXT_PUBLIC_PARTY_1_URL=https://localhost:8101
NEXT_PUBLIC_PARTY_2_URL=https://localhost:8102
