# Copy to .env and replace every CHANGE_ME value with a unique random value.
# Use URL-safe values because POSTGRES_PASSWORD is interpolated into DATABASE_URL.

POSTGRES_USER=veilbench_user
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DATABASE_PASSWORD
POSTGRES_DB=veilbench_db

# Protects coordinator management endpoints (not founder salary submission).
COORDINATOR_ADMIN_TOKEN=CHANGE_ME_RANDOM_ADMIN_TOKEN

# Signs one short-lived, party-specific founder submission capability per session.
MPC_FOUNDER_TOKEN_SECRET_0=CHANGE_ME_RANDOM_FOUNDER_SIGNING_SECRET_0
MPC_FOUNDER_TOKEN_SECRET_1=CHANGE_ME_RANDOM_FOUNDER_SIGNING_SECRET_1
MPC_FOUNDER_TOKEN_SECRET_2=CHANGE_ME_RANDOM_FOUNDER_SIGNING_SECRET_2

# Separate control credentials; each belongs only to its corresponding party.
MPC_NODE0_TOKEN=CHANGE_ME_RANDOM_PARTY_0_CONTROL_TOKEN
MPC_NODE1_TOKEN=CHANGE_ME_RANDOM_PARTY_1_CONTROL_TOKEN
MPC_NODE2_TOKEN=CHANGE_ME_RANDOM_PARTY_2_CONTROL_TOKEN
